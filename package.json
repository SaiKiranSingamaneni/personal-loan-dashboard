{
  "name": "personal-loan-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace @loan-dashboard/api\" \"npm run dev --workspace @loan-dashboard/web\"",
    "dev:scratch": "node scripts/dev-scratch.mjs",
    "start": "npm run build && node scripts/start-production.mjs",
    "build": "tsc --build && npm run build --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:relocate": "npm run db:relocate --workspace @loan-dashboard/api --",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.1.2",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.5"
  }
}
